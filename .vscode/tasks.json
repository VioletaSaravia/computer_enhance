{
    "tasks": [
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe debug build",
            "command": "cl.exe",
            "args": [
                "/Zi",
                "/O1",
                "/I${workspaceFolder}\\source",
                "/I${workspaceFolder}\\vendor",
                "/std:c++20",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}\\build\\debug\\${workspaceFolderBasename}.exe",
                "/Fo${workspaceFolder}\\build\\debug\\",
                "/Fd${workspaceFolder}\\build\\debug\\",
                "${workspaceFolder}\\source\\main\\main_release.cpp",
                // "${workspaceFolder}\\vendor\\imgui-1.92.2b\\backends\\imgui_impl_sdl3.cpp",
                // "${workspaceFolder}\\vendor\\imgui-1.92.2b\\backends\\imgui_impl_opengl3.cpp",
                // "${workspaceFolder}\\vendor\\imgui-1.92.2b\\imgui*.cpp",
                "${workspaceFolder}\\build\\debug\\imgui*.obj",
                "${workspaceFolder}\\source\\asm\\nop_loop.obj",
                "${workspaceFolder}\\source\\asm\\nop_loop.lib",
                "${workspaceFolder}\\source\\asm\\multinop_loops.obj",
                "${workspaceFolder}\\source\\asm\\multinop_loops.lib",
                "x64\\SDL3.lib",
                "/link",
                "/LIBPATH:${workspaceFolder}\\vendor\\SDL3\\lib",
                // "/LIBPATH:${workspaceFolder}\\source\\asm"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Task generated by Debugger.",
        },
        {
            "type": "cppbuild",
            "label": "C/C++: cl.exe release build",
            "command": "cl.exe",
            "args": [
                "/O2",
                "/Ot",
                "/I${workspaceFolder}\\source",
                "/I${workspaceFolder}\\vendor",
                "/std:c++20",
                "/EHsc",
                "/nologo",
                "/Fe${workspaceFolder}\\build\\win32\\${workspaceFolderBasename}.exe",
                "/Fo${workspaceFolder}\\build\\win32\\",
                "/Fd${workspaceFolder}\\build\\win32\\",
                "${workspaceFolder}\\source\\main\\main_release.cpp",
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$msCompile"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated by Debugger."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ build active file",
            "command": "clang++",
            "args": [
                "-g",
                "-std=c++20",
                "-Wall",
                "-Wextra",
                "-Wpedantic",
                "-Wshadow",
                "-Wformat=2",
                "-Wundef",
                "-Wfloat-equal",
                "-Wno-deprecated-declarations",
                "-Wswitch-enum",
                "-o",
                "${fileDirname}/build/${fileBasenameNoExtension}.exe",
                "${file}",
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated for Clang."
        },
        {
            "type": "cppbuild",
            "label": "C/C++: clang++ release build active file",
            "command": "clang++",
            "args": [
                "-std=c++20",
                "-O2",
                "-Wall",
                "-Werror",
                "-Wextra",
                "-Wpedantic",
                "-Wshadow",
                "-Wformat=2",
                "-Wundef",
                "-Wfloat-equal",
                "-Wno-deprecated-declarations",
                "-Wswitch-enum",
                "-o",
                "${fileDirname}/build/${fileBasenameNoExtension}.exe",
                "${file}",
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": false
            },
            "detail": "Task generated for Clang."
        },
        {
            "label": "Copy SDL3 DLL",
            "type": "shell",
            "command": "copy",
            "args": [
                "${workspaceFolder}\\vendor\\SDL3\\lib\\x64\\SDL3.dll",
                "${fileDirname}\\build\\SDL3.dll"
            ],
            "problemMatcher": []
        }
    ],
    "version": "2.0.0"
}